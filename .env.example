SECRET_KEY=django-insecure-ringfinder-secret-key-super-secure-change-in-prod
DEBUG=True

# Database Configuration (Inbuilt SQLite by default - No manual DB setup required!)
USE_MYSQL=False

# Optional MySQL configuration (if enabled with USE_MYSQL=True)
DB_NAME=ringfinder
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT Token Lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1
